# Public app URL (used for GitHub OAuth fallback)
APP_URL=http://localhost:3000

# GitHub OAuth App (repository access — not login). Optional if you set GITHUB_TOKEN.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/api/github/callback

# Encrypts the GitHub session cookie when using OAuth or a pasted PAT (min 16 characters)
GITHUB_TOKEN_ENCRYPTION_KEY=

# Optional: use a server-side token instead of OAuth (self-host)
# GITHUB_TOKEN=

# Optional leftover SaaS env (not required for session scans)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# CRON_SECRET=
# AUTH_DEV_BYPASS=false
