# Supabase (required) — see docs/supabase/README.md
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Dashboard API keys: publishable (preferred). Legacy JWT anon still works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-jwt
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public app URL (used for GitHub OAuth fallback)
APP_URL=http://localhost:3000

# GitHub OAuth App (repository access — not login)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/api/github/callback

# Encrypts GitHub access tokens at rest (min 16 characters)
GITHUB_TOKEN_ENCRYPTION_KEY=

# Scheduled scans (Vercel Cron sends Authorization: Bearer CRON_SECRET)
CRON_SECRET=

# Skip auth redirects during local development only (ignored in production).
# Leave false to test login/logout. true keeps /dashboard open without a session.
AUTH_DEV_BYPASS=false

# Optional: Slack alerts use the webhook stored on companies.monitoring.
# Optional: email alerts via Resend (leave blank to skip email)
# RESEND_API_KEY=
# NOTIFY_FROM_EMAIL=SecureStack <alerts@example.com>

# Fail fast in production when secrets / shared rate limiting are missing
# ENFORCE_PRODUCTION_ENV=true

# Recommended in production: shared login rate limiting (Upstash Redis).
# Without these, login uses an in-memory limiter (fine for single-instance demos).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
