# Public app URL (used for GitHub OAuth fallback)
APP_URL=http://localhost:3000

# GitHub OAuth App (repository access — not product login).
# HOST / Vercel only. Website visitors never set these and never install anything.
# They click "Connect GitHub" and authorize their own GitHub account.
# Create the app at https://github.com/settings/developers
# Add BOTH callbacks on that app:
#   http://localhost:3000/api/github/callback
#   https://YOUR_DOMAIN/api/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Leave unset on Vercel — callback is {APP_URL}/api/github/callback
# GITHUB_REDIRECT_URI=

# Encrypts the GitHub session cookie (min 16 characters).
# Optional on localhost — a development key is used if this is empty.
# Required on Vercel / production.
GITHUB_TOKEN_ENCRYPTION_KEY=

# Optional: instance-wide GitHub token (skips OAuth). Every visitor can scan
# whatever this token can read — do not set on a public internet host.
# GITHUB_TOKEN=

# Optional: shared scan rate limiting across instances
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional: fail fast in production when Upstash is missing
# ENFORCE_PRODUCTION_ENV=true
