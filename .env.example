# Public app URL (used for GitHub OAuth fallback)
APP_URL=http://localhost:3000

# GitHub OAuth App (repository access — not product login). Optional if you set GITHUB_TOKEN.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/api/github/callback

# Encrypts the GitHub session cookie when using OAuth or a pasted PAT (min 16 characters)
GITHUB_TOKEN_ENCRYPTION_KEY=

# Optional: use a server-side token instead of OAuth (self-host)
# GITHUB_TOKEN=

# Optional: shared scan rate limiting across instances
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional: fail fast in production when Upstash is missing
# ENFORCE_PRODUCTION_ENV=true
